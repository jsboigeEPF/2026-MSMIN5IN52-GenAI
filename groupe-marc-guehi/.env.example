# Copier en .env et remplir. Ne JAMAIS commiter .env.

# --- STT : serveur Whisper large-v3-turbo de l'école (API compatible OpenAI) ---
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo

# --- LLM : OpenRouter (chat completions, streaming) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Slug exact à copier depuis la page du modèle sur openrouter.ai
LLM_MODEL=
LLM_MODEL_ALT=

# --- TTS : OpenRouter (Qwen-Audio-3.0-TTS Flash, alt. Speech 2.8 Turbo) ---
TTS_BASE_URL=https://openrouter.ai/api/v1
TTS_API_KEY=
TTS_MODEL=minimax/speech-2.8-turbo
TTS_MODEL_ALT=qwen/qwen-audio-3.0-tts-flash
# Une voix tirée au hasard au début de chaque conversation (liste séparée par des virgules)
TTS_VOICES=French_Male_Speech_New,French_Female_Speech_New

# --- Garde-fous coût (voir docs/CONSTRAINTS.md) ---
BUDGET_MAX_EUR=10
